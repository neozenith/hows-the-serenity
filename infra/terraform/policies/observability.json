{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "ManageProjectLogGroups",
			"Effect": "Allow",
			"Action": "logs:*",
			"Resource": [
				"arn:aws:logs:*:979037402244:log-group:/hts/*",
				"arn:aws:logs:*:979037402244:log-group:/ecs/hts-*",
				"arn:aws:logs:*:979037402244:log-group:/aws/ecs/hts-*",
				"arn:aws:logs:*:979037402244:log-group:/aws/lambda/hts-*",
				"arn:aws:logs:*:979037402244:log-group:/aws/vendedlogs/hts-*"
			]
		},
		{
			"Sid": "DescribeAndQueryLogs",
			"Effect": "Allow",
			"Action": [
				"logs:DescribeLogGroups",
				"logs:DescribeQueries",
				"logs:GetQueryResults",
				"logs:StopQuery"
			],
			"Resource": "*"
		},
		{
			"Sid": "ManageCloudWatch",
			"Effect": "Allow",
			"Action": "cloudwatch:*",
			"Resource": "*"
		}
	]
}

{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "ProjectData",
			"Effect": "Allow",
			"Action": "s3:*",
			"Resource": [
				"arn:aws:s3:::isochrones-data-backup-979037402244",
				"arn:aws:s3:::isochrones-data-backup-979037402244/*",
				"arn:aws:s3:::hts-*",
				"arn:aws:s3:::hts-*/*"
			]
		},
		{
			"Sid": "PullImagesAndWriteLogs",
			"Effect": "Allow",
			"Action": [
				"ecr:GetAuthorizationToken",
				"ecr:BatchCheckLayerAvailability",
				"ecr:GetDownloadUrlForLayer",
				"ecr:BatchGetImage",
				"logs:CreateLogGroup",
				"logs:CreateLogStream",
				"logs:PutLogEvents",
				"cloudwatch:PutMetricData"
			],
			"Resource": "*"
		},
		{
			"Sid": "ProjectSecrets",
			"Effect": "Allow",
			"Action": [
				"secretsmanager:GetSecretValue",
				"ssm:GetParameter",
				"ssm:GetParameters"
			],
			"Resource": [
				"arn:aws:secretsmanager:*:979037402244:secret:hts-*",
				"arn:aws:ssm:*:979037402244:parameter/hts/*"
			]
		},
		{
			"Sid": "ProjectServerlessRuntime",
			"Effect": "Allow",
			"Action": [
				"lambda:InvokeFunction",
				"events:PutEvents",
				"sqs:SendMessage",
				"sqs:ReceiveMessage",
				"sqs:DeleteMessage",
				"sqs:ChangeMessageVisibility",
				"sqs:GetQueueAttributes",
				"sqs:GetQueueUrl",
				"sns:Publish",
				"dynamodb:GetItem",
				"dynamodb:BatchGetItem",
				"dynamodb:PutItem",
				"dynamodb:UpdateItem",
				"dynamodb:DeleteItem",
				"dynamodb:BatchWriteItem",
				"dynamodb:Query",
				"dynamodb:Scan",
				"dynamodb:ConditionCheckItem",
				"dynamodb:DescribeStream",
				"dynamodb:GetRecords",
				"dynamodb:GetShardIterator",
				"dynamodb:ListStreams"
			],
			"Resource": [
				"arn:aws:lambda:*:979037402244:function:hts-*",
				"arn:aws:events:*:979037402244:event-bus/*",
				"arn:aws:sqs:*:979037402244:hts-*",
				"arn:aws:sns:*:979037402244:hts-*",
				"arn:aws:dynamodb:*:979037402244:table/hts-*",
				"arn:aws:dynamodb:*:979037402244:table/hts-*/*"
			]
		},
		{
			"Sid": "SchedulerRunsProjectTasks",
			"Effect": "Allow",
			"Action": "ecs:RunTask",
			"Resource": "*"
		},
		{
			"Sid": "SchedulerPassesProjectRoles",
			"Effect": "Allow",
			"Action": "iam:PassRole",
			"Resource": "arn:aws:iam::979037402244:role/hts-*"
		}
	]
}

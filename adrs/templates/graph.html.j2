{#- Self-contained Cytoscape viewer for the decision graph. Generated.

    Three data blocks are inlined so the page works from file:// with no server:
    the cytoscape elements, each record's rendered markdown (so the reading pane
    needs no fetch), and the design tokens both themes use.

    Everything outside those blocks is wrapped in {% raw %} because the CSS and
    JS are full of braces that Jinja would otherwise try to interpret.
-#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Decision graph &middot; {{ bundle_name }}</title>
<!-- GENERATED by okf_render.py from {{ bundle_name }}/*.yml. Do not edit; run the bundle's regenerate target. -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.30.2/cytoscape.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/14.1.2/marked.min.js"></script>
{% raw %}
<style>
:root {
  color-scheme: light dark;
  --bg: #f7f7fa; --panel: #ffffff; --ink: #1b1d23; --muted: #5b6070;
  --line: #e2e4ea; --accent: #4f46e5; --good: #047857; --bad: #b91c1c; --code: #f1f2f6;
  --body: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, monospace;
}
:root[data-theme="dark"] {
  --bg: #0f1117; --panel: #171a23; --ink: #e6e8ef; --muted: #9aa0b0;
  --line: #2a2e3a; --accent: #a5b4fc; --good: #34d399; --bad: #f87171; --code: #1f2330;
}
* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body {
  display: flex; flex-direction: column;
  background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 15px; line-height: 1.55;
}
header {
  display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
  padding: 10px 18px; border-bottom: 1px solid var(--line); background: var(--panel);
}
h1 { font-size: 15px; font-weight: 600; margin: 0; }
h1 .sub { color: var(--muted); font-weight: 400; }
.spacer { flex: 1; }
input[type="search"], button, select {
  font: inherit; color: inherit; background: var(--bg);
  border: 1px solid var(--line); border-radius: 6px; padding: 5px 10px;
}
input[type="search"] { min-width: 190px; }
button { cursor: pointer; }
button:hover, select:hover { border-color: var(--accent); }
nav#groups {
  display: flex; gap: 6px; flex-wrap: wrap; align-items: center;
  padding: 8px 18px; border-bottom: 1px solid var(--line); background: var(--panel);
}
.gchip {
  display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
  font-size: 12px; padding: 3px 10px 3px 7px; border-radius: 999px;
  border: 1px solid var(--line); background: var(--bg); color: var(--muted);
}
.gchip .sw { width: 9px; height: 9px; border-radius: 50%; }
.gchip .n { font-family: var(--mono); font-size: 11px; opacity: .7; }
.gchip[aria-pressed="true"] { color: var(--ink); border-color: currentColor; }
.gchip:hover { border-color: var(--accent); }
main { flex: 1; display: flex; min-height: 0; }
#cy { flex: 1 1 58%; min-width: 0; background: var(--bg); }
#pane {
  flex: 1 1 42%; max-width: 720px; min-width: 0; overflow-y: auto;
  border-left: 1px solid var(--line); background: var(--panel); padding: 22px 26px 60px;
}
#pane.empty { display: flex; align-items: center; justify-content: center; color: var(--muted); text-align: center; }
.reader-nav { display: none; }
.legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12px; color: var(--muted); align-items: center; }
.legend b { font-weight: 600; color: var(--ink); }
.key { display: inline-flex; align-items: center; gap: 5px; }
.key i { width: 22px; height: 0; border-top-width: 2px; display: inline-block; }
.dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
.meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 4px; }
.chip {
  font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase;
  padding: 2px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted);
}
/* A filename is a path, not a label: uppercasing it makes it unreadable. */
a.chip { text-transform: none; letter-spacing: 0; max-width: 100%; overflow: hidden;
         text-overflow: ellipsis; white-space: nowrap; }
.chip.accepted { color: var(--good); border-color: currentColor; }
.chip.superseded, .chip.retired { color: var(--bad); border-color: currentColor; }
#pane h1:first-of-type { font-size: 21px; line-height: 1.3; margin: 6px 0 14px; }
#pane h2 { font-size: 16px; margin: 26px 0 8px; padding-top: 14px; border-top: 1px solid var(--line); }
#pane h3 { font-size: 14px; margin: 18px 0 6px; color: var(--muted); }
#pane code { font-family: var(--mono); font-size: .88em; background: var(--code); padding: 1px 5px; border-radius: 4px; }
#pane pre { background: var(--code); padding: 12px 14px; border-radius: 8px; overflow-x: auto; }
#pane pre code { background: none; padding: 0; }
#pane table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; font-size: 13px; }
#pane th, #pane td { border: 1px solid var(--line); padding: 6px 9px; text-align: left; vertical-align: top; }
#pane th { background: var(--code); }
#pane blockquote { margin: 0; padding-left: 14px; border-left: 3px solid var(--accent); color: var(--muted); }
#pane a { color: var(--accent); }
#pane a.adr { text-decoration-style: dotted; }
.nofx { padding: 26px; color: var(--bad); font-family: var(--mono); font-size: 13px; }
@media (max-width: 900px) {
  body { height: 100dvh; overflow: hidden; }
  header { gap: 8px; padding: 10px 12px; flex-shrink: 0; }
  header h1 { flex-basis: 100%; }
  header .legend, header .spacer { display: none; }
  input[type="search"] { flex: 1 1 100%; min-width: 0; }
  header button, header select, .reader-nav button { min-height: 44px; }
  nav#groups { flex-wrap: nowrap; overflow-x: auto; padding: 6px 12px; flex-shrink: 0; }
  .gchip { flex-shrink: 0; min-height: 44px; }
  main { flex-direction: column; }
  #cy { flex: 1; }
  #pane.empty { display: none; }
  #pane:not(.empty) {
    position: fixed; inset: 0; z-index: 10; max-width: none;
    border: 0; padding: 0 18px calc(32px + env(safe-area-inset-bottom));
    overflow-wrap: anywhere; overscroll-behavior: contain;
  }
  .reader-nav {
    display: flex; align-items: center; position: sticky; top: 0; z-index: 1;
    margin: 0 -18px 18px; padding: calc(10px + env(safe-area-inset-top)) 18px 10px;
    background: var(--panel); border-bottom: 1px solid var(--line);
  }
}
</style>
{% endraw %}
</head>
<body>
<header>
  <h1>Decision graph <span class="sub">{{ node_count }} records &middot; {{ edge_count }} typed edges</span></h1>
  <div class="legend">
    <span class="key"><i style="border-top-style:solid;border-color:var(--bad)"></i> supersedes</span>
    <span class="key"><i style="border-top-style:dashed;border-color:var(--accent)"></i> other relations</span>
    <span class="key"><b>colour</b> = group</span>
    <span class="key"><b>size</b> = records that refine it</span>
    <span class="key"><span class="dot" style="border:2px solid var(--bad);background:transparent"></span> superseded</span>
  </div>
  <span class="spacer"></span>
  <input type="search" id="q" placeholder="filter by number or title" autocomplete="off">
  <select id="layout" title="graph layout">
    <option value="grouped">grouped</option>
    <option value="cose">force</option>
    <option value="breadthfirst">hierarchy</option>
    <option value="concentric">concentric</option>
  </select>
  <button id="fit">fit</button>
  <button id="theme" title="toggle light and dark">&#9686;</button>
</header>
<nav id="groups" aria-label="filter by group"></nav>
<main>
  <div id="cy" tabindex="0" role="region" aria-label="Decision graph"></div>
  <div id="pane" class="empty" role="region" aria-label="Decision record"><p>Select a record to read it.<br>Links between records navigate the graph.</p></div>
</main>

<script id="graph-data" type="application/json">{{ graph_json }}</script>
<script id="record-data" type="application/json">{{ records_json }}</script>
<script id="token-data" type="application/json">{{ tokens_json }}</script>
{% raw %}
<script>
(function () {
  "use strict";
  const read = (id) => JSON.parse(document.getElementById(id).textContent);
  const graph = read("graph-data");
  const RECORDS = read("record-data");
  const TOKENS = read("token-data");
  const pane = document.getElementById("pane");
  // A function declaration, not a const: applyTheme() runs before the graph exists
  // and would otherwise hit the temporal dead zone.
  function css(name) {
    return getComputedStyle(document.documentElement).getPropertyValue("--" + name).trim();
  }
  // Never `window.cy`: an element with id="cy" already claims that name through named
  // access on window, so the theme pass would style a <div> and throw.
  let graphInstance = null;

  if (!window.cytoscape || !window.marked) {
    document.getElementById("cy").innerHTML =
      '<p class="nofx">cytoscape.js and marked.js load from cdnjs.cloudflare.com. ' +
      "This page is otherwise self-contained; with no network the graph cannot draw. " +
      "The same records are readable as markdown in index.md.</p>";
    return;
  }

  // ---- theme -----------------------------------------------------------------
  // Both themes' values are written as CSS custom properties up front; the toggle
  // only flips which set is live.
  const themes = (TOKENS.themes) || {};
  function applyTheme(name) {
    document.documentElement.setAttribute("data-theme", name);
    const t = themes[name];
    if (t) {
      for (const [k, v] of Object.entries(t)) {
        if (typeof v === "string") document.documentElement.style.setProperty("--" + k, v);
      }
    }
    try { localStorage.setItem("adr-graph-theme", name); } catch (_) { /* opaque file:// origin */ }
    if (graphInstance) style(graphInstance);
  }
  let stored = null;
  try { stored = localStorage.getItem("adr-graph-theme"); } catch (_) { /* opaque file:// origin */ }
  const preferred =
    stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  applyTheme(preferred);
  document.getElementById("theme").onclick = () =>
    applyTheme(document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark");

  // ---- elements --------------------------------------------------------------
  // graph.json carries the neutral data, compound parents included: each record
  // declares one group. Presentation is decided here, and both channels are derived
  // rather than assigned: fill is the group, size is in-degree (how many records
  // refine or supersede this one). Status rides on the border, because usually only
  // a couple of records are superseded and a whole colour channel would be wasted.
  const elements = graph.elements;
  const GROUPS = elements
    .filter((e) => String(e.data.id).startsWith("group-"))
    .map((e) => ({ id: e.data.id, label: e.data.label, colour: e.data.colour }))
    .sort((a, b) => a.label.localeCompare(b.label));

  const indegree = {};
  for (const e of elements) if (e.data.source) indegree[e.data.target] = (indegree[e.data.target] || 0) + 1;
  for (const e of elements) if (!e.data.source) e.data.weight = indegree[e.data.id] || 0;

  function style(cy) {
    cy.style([
      {
        selector: "node",
        style: {
          "background-color": "data(colour)",
          label: "data(label)",
          color: "#ffffff",
          "font-family": "ui-monospace, Menlo, monospace",
          "font-size": 10,
          "text-valign": "center",
          "text-halign": "center",
          width: (n) => 22 + Math.min(n.data("weight"), 10) * 3.4,
          height: (n) => 22 + Math.min(n.data("weight"), 10) * 3.4,
          "border-width": 0,
        },
      },
      {
        // A compound parent is a container, not a node: no fill of its own beyond a
        // wash of its group colour, and its name sits above the cluster.
        selector: ":parent",
        style: {
          "background-color": "data(colour)",
          "background-opacity": 0.07,
          "border-width": 1,
          "border-color": "data(colour)",
          "border-opacity": 0.45,
          "border-style": "dashed",
          shape: "round-rectangle",
          padding: 14,
          label: "data(label)",
          color: "data(colour)",
          "font-size": 12,
          "font-weight": "bold",
          "text-valign": "top",
          "text-halign": "center",
          "text-margin-y": -4,
        },
      },
      {
        // A status that is not "accepted" earns a ring rather than a hue.
        selector: 'node[status = "superseded"], node[status = "retired"]',
        style: { "border-width": 3, "border-color": css("bad"), "border-opacity": 1 },
      },
      {
        selector: 'node[status = "proposed"]',
        style: { "border-width": 2, "border-color": css("muted"), "border-opacity": 1, "border-style": "dotted" },
      },
      {
        selector: "edge",
        style: {
          width: 1.4,
          "line-color": (e) => (e.data("relation").startsWith("supersede") ? css("bad") : css("accent")),
          "target-arrow-color": (e) => (e.data("relation").startsWith("supersede") ? css("bad") : css("accent")),
          "target-arrow-shape": "triangle",
          "arrow-scale": 0.8,
          "curve-style": "bezier",
          "line-style": (e) => (e.data("relation").startsWith("supersede") ? "solid" : "dashed"),
          opacity: 0.5,
        },
      },
      { selector: "node.sel", style: { "border-width": 4, "border-color": css("ink"), "border-opacity": 1 } },
      { selector: ":parent.dim", style: { "background-opacity": 0.02, "border-opacity": 0.12, "text-opacity": 0.25 } },
      { selector: "node.dim, edge.dim", style: { opacity: 0.15 } },
      { selector: "edge.hot", style: { opacity: 1, width: 2.4 } },
      { selector: "node.hot", style: { opacity: 1 } },
    ]);
  }

  // ---- the grouped layout ------------------------------------------------------
  // Computed here rather than left to a force layout, for two reasons. Cytoscape's
  // built-in `cose` is only nominally compound-aware: records whose edges reach across
  // groups get dragged out of their own cluster, which collapses several groups to a
  // few pixels. And a force layout is non-deterministic, so a committed generated file
  // would draw a different picture on every rebuild. The purpose-built compound
  // layouts (fcose, cose-bilkent) are not on the CDN this page is allowed to use.
  //
  // Shelf packing: each group becomes a grid of its records, the grids are laid out
  // left to right and wrapped, and every position is a pure function of the sorted
  // record ids. Same input, same picture, every time.
  const SLOT = 66;          // one record's cell, in graph units
  const GAP = 46;           // between group boxes

  function groupedPositions() {
    const boxes = GROUPS.map((g) => {
      const kids = elements
        .filter((e) => e.data.parent === g.id)
        .map((e) => e.data.id)
        .sort();
      const cols = Math.max(1, Math.ceil(Math.sqrt(kids.length)));
      const rows = Math.ceil(kids.length / cols);
      return { ...g, kids, cols, rows, w: cols * SLOT, h: rows * SLOT };
    });

    // Wrap width is derived from the total area and the pane's aspect ratio, so the
    // arrangement stays roughly as wide as the space it has to fit into. A fixed width
    // produces a long thin strip that fits to almost nothing in a tall pane.
    const area = boxes.reduce((a, b) => a + (b.w + GAP) * (b.h + GAP), 0);
    const box = document.getElementById("cy").getBoundingClientRect();
    const aspect = box.width && box.height ? box.width / box.height : 1;
    const shelf = Math.max(
      Math.max(...boxes.map((b) => b.w)),
      Math.sqrt(area * Math.max(aspect, 0.6)),
    );

    const pos = {};
    let x = 0, y = 0, shelfHeight = 0;
    for (const b of boxes) {
      if (x > 0 && x + b.w > shelf) { x = 0; y += shelfHeight + GAP; shelfHeight = 0; }
      b.kids.forEach((id, i) => {
        pos[id] = {
          x: x + (i % b.cols) * SLOT + SLOT / 2,
          y: y + Math.floor(i / b.cols) * SLOT + SLOT / 2,
        };
      });
      x += b.w + GAP;
      shelfHeight = Math.max(shelfHeight, b.h);
    }
    return pos;
  }

  const GROUPED = {
    name: "preset",
    positions: (n) => groupedPositions()[n.id()],
    padding: 40,
    animate: false,
    fit: true,
  };

  const cy = cytoscape({
    container: document.getElementById("cy"),
    elements,
    layout: GROUPED,
    wheelSensitivity: 0.2,
  });
  graphInstance = cy;
  window.__adrGraph = cy;  // a browser check reaches the instance through this
  style(cy);

  // ---- selection -------------------------------------------------------------
  // A title is data, not markup: a record whose title contains "<" would
  // otherwise inject into the pane.
  const escapeHtml = (s) =>
    String(s).replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c],
    );

  function syncReaderMode() {
    const mobileOpen = window.matchMedia("(max-width: 900px)").matches && !pane.classList.contains("empty");
    for (const element of [document.querySelector("header"), document.getElementById("groups"), document.getElementById("cy")]) {
      element.inert = mobileOpen;
    }
    pane.setAttribute("role", mobileOpen ? "dialog" : "region");
    if (mobileOpen) pane.setAttribute("aria-modal", "true");
    else pane.removeAttribute("aria-modal");
  }

  function closeReader() {
    pane.classList.add("empty");
    pane.innerHTML = "<p>Select a record to read it.<br>Links between records navigate the graph.</p>";
    syncReaderMode();
    history.replaceState(null, "", "#");
    document.getElementById("cy").focus({ preventScroll: true });
  }

  function show(id) {
    const rec = RECORDS[id];
    if (!rec) return;
    cy.batch(() => {
      cy.elements().removeClass("sel hot dim").addClass("dim");
      const node = cy.getElementById(id);
      const focus = node.closedNeighborhood();
      focus.removeClass("dim").addClass("hot");
      // Compound opacity multiplies into its children, even when a child is hot.
      // Keep every focused endpoint's containers visible, including nested groups.
      focus.nodes().ancestors().removeClass("dim");
      node.addClass("sel");
    });
    pane.classList.remove("empty");
    // The record's markdown arrives without its frontmatter, because a renderer
    // would show that block as a heading. Its fields are the chips and the title
    // below, so nothing is lost.
    pane.innerHTML =
      '<div class="reader-nav"><button type="button" id="back-to-graph">Back to graph</button></div>' +
      '<div class="meta"><span class="chip">' + id + '</span>' +
      '<span class="chip ' + rec.status + '">' + rec.status + "</span>" +
      '<a class="chip" href="' + rec.file + '">' + rec.file + "</a></div>" +
      '<h1 id="record-title" tabindex="-1">' + escapeHtml(rec.title) + "</h1>" +
      '<div id="doc">' + marked.parse(rec.markdown) + "</div>";
    // A link to another record navigates the graph instead of leaving the page. Scoped
    // to the rendered body: the chip above links to this record's own file and must keep
    // its native behaviour, or it would rewire into a no-op that reselects the current
    // record.
    for (const a of pane.querySelectorAll('#doc a[href$=".md"]')) {
      const target = Object.keys(RECORDS).find((k) => RECORDS[k].file === a.getAttribute("href"));
      if (!target) continue;
      a.classList.add("adr");
      a.addEventListener("click", (ev) => { ev.preventDefault(); select(target); });
    }
    pane.scrollTop = 0;
    document.getElementById("back-to-graph").addEventListener("click", closeReader);
    syncReaderMode();
    if (window.matchMedia("(max-width: 900px)").matches) {
      document.getElementById("record-title").focus({ preventScroll: true });
    }
  }

  function select(id) {
    show(id);
    history.replaceState(null, "", "#" + id);
    const n = cy.getElementById(id);
    if (n.length) {
      cy.animate({ center: { eles: n }, zoom: Math.max(cy.zoom(), 0.75) }, { duration: 220 });
    }
  }

  cy.on("tap", "node", (ev) => select(ev.target.id()));
  cy.on("tap", (ev) => {
    if (ev.target !== cy) return;
    cy.elements().removeClass("sel hot dim");
    closeReader();
  });

  // ---- controls --------------------------------------------------------------
  // One chip per group. Clicking isolates that group; clicking again restores the
  // whole graph. Counts come from the elements, so the legend cannot disagree with them.
  const nav = document.getElementById("groups");
  let isolated = null;
  for (const g of GROUPS) {
    const count = cy.getElementById(g.id).children().length;
    const chip = document.createElement("button");
    chip.className = "gchip";
    chip.type = "button";
    chip.setAttribute("aria-pressed", "false");
    chip.dataset.group = g.id;
    chip.innerHTML =
      '<span class="sw" style="background:' + g.colour + '"></span>' + g.label +
      ' <span class="n">' + count + "</span>";
    chip.onclick = () => {
      isolated = isolated === g.id ? null : g.id;
      for (const c of nav.children) c.setAttribute("aria-pressed", String(c.dataset.group === isolated));
      cy.batch(() => {
        cy.elements().removeClass("dim");
        if (!isolated) return;
        const keep = cy.getElementById(isolated).children();
        cy.elements().addClass("dim");
        keep.removeClass("dim");
        cy.getElementById(isolated).removeClass("dim");
        // Only edges with both ends inside the group. A cross-group edge left lit
        // terminates at a node that is no longer drawn, which reads as a stray line.
        keep.edgesWith(keep).removeClass("dim");
      });
    };
    nav.appendChild(chip);
  }

  document.getElementById("fit").onclick = () => cy.fit(undefined, 30);
  document.getElementById("layout").onchange = (ev) => {
    const choice = ev.target.value;
    // The alternates are force- or tree-based and ignore compound containment, so the
    // group boxes stretch to wherever their records land. That is a fair view of the
    // relation structure; `grouped` is the one that keeps the groups legible.
    cy.layout(
      choice === "grouped"
        ? GROUPED
        : {
            name: choice, animate: false, padding: 30, directed: true, spacingFactor: 1.15,
            nodeRepulsion: 12000, idealEdgeLength: 70, nestingFactor: 1.2, numIter: 1000,
          },
    ).run();
    cy.fit(undefined, 30);
  };

  document.getElementById("q").addEventListener("input", (ev) => {
    const q = ev.target.value.trim().toLowerCase();
    cy.batch(() => {
      if (!q) { cy.elements().removeClass("dim"); return; }
      cy.nodes().forEach((n) => {
        if (n.isParent()) { n.addClass("dim"); return; }
        const hit =
          n.id().toLowerCase().includes(q) ||
          (n.data("title") || "").toLowerCase().includes(q) ||
          (n.data("group") || "").toLowerCase().includes(q);
        n.toggleClass("dim", !hit);
      });
      cy.edges().addClass("dim");
    });
  });

  window.addEventListener("keydown", (ev) => {
    if (ev.key === "Escape" && pane.getAttribute("aria-modal") === "true") {
      closeReader();
      return;
    }
    if (ev.key === "Escape") { document.getElementById("q").value = ""; cy.elements().removeClass("dim"); }
    if (ev.key === "/" && document.activeElement !== document.getElementById("q")) {
      ev.preventDefault(); document.getElementById("q").focus();
    }
  });

  // The hash is the address. Honour it on load and on every later change, so the
  // browser's back and forward buttons walk the reading history and a pasted link opens
  // its record.
  function fromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (RECORDS[id]) show(id);
  }
  window.addEventListener("hashchange", fromHash);

  // Fit once the first layout has settled, then honour any deep link. Fitting before
  // the layout runs measures an empty extent and leaves the graph off-screen.
  cy.ready(() => {
    cy.fit(undefined, 30);
    const deep = decodeURIComponent(location.hash.slice(1));
    if (RECORDS[deep]) select(deep);
  });
  window.addEventListener("resize", () => {
    syncReaderMode();
    cy.fit(undefined, 30);
  });
})();
</script>
